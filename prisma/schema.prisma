generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  RELAIS
  ADMIN
}

enum UserAccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum RelaisEligibility {
  APPROVED
  UNDER_REVIEW
  REVOKED
}

enum RelaisAvailability {
  AVAILABLE
  UNAVAILABLE
}

enum ConnectionLifecycle {
  MATCHING
  CONNECTED
  ENDED
}

enum ConnectionTerminalOutcome {
  MISSION_CREATED
  CUSTOMER_CANCELLED
  DECLINED
  DECLINED_BY_RELAIS
  NO_RELAIS_AVAILABLE
  ABANDONED
}

enum MessageType {
  TEXT
  VOICE
}

enum QuickOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
  CANCELLED
}

enum MissionDepth {
  QUICK
  MANAGED
}

enum MissionUrgency {
  NORMAL
  URGENT
}

enum MissionLifecycle {
  PENDING_EXECUTION
  ACTIVE
  COMPLETION_PENDING
  COMPLETED
  CANCELLED
  FAILED
}

enum PaymentObligationPurpose {
  RELAIS_FEE
  MISSION_FUNDS
}

enum PaymentObligationStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentAttemptStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  CASH
  MANUAL_TRANSFER
}

enum PaymentConfirmationSource {
  PROVIDER
  MANUAL
}

model User {
  id                          String                 @id @default(cuid())
  // Nullable for pre-phone legacy users; new Customer provisioning always sets both fields.
  phoneNumber                 String?                @unique @db.VarChar(20)
  phoneVerifiedAt             DateTime?
  role                        UserRole
  accountStatus               UserAccountStatus      @default(ACTIVE)
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  customerProfile             CustomerProfile?
  relaisProfile               RelaisProfile?
  customerConnections         Connection[]           @relation("CustomerConnections")
  relaisAssignments           ConnectionAssignment[] @relation("RelaisAssignments")
  initiatedAssignments        ConnectionAssignment[] @relation("AssignmentInitiator")
  sentMessages                Message[]              @relation("MessageSender")
  initiatedCallActions        CallAction[]           @relation("CallActionInitiator")
  receivedCallActions         CallAction[]           @relation("CallActionTarget")
  createdQuickOffers          QuickOffer[]           @relation("QuickOfferCreator")
  missionAssignments          MissionAssignment[]    @relation("MissionRelaisAssignments")
  initiatedMissionAssignments MissionAssignment[]    @relation("MissionAssignmentInitiator")
  confirmedPaymentAttempts    PaymentAttempt[]       @relation("PaymentConfirmationActor")

  @@index([role])
  @@index([accountStatus])
}

model CustomerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  preferredLanguage String?  @db.VarChar(16)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model RelaisProfile {
  id                    String             @id @default(cuid())
  userId                String             @unique
  eligibility           RelaisEligibility  @default(UNDER_REVIEW)
  availability          RelaisAvailability @default(UNAVAILABLE)
  availabilityChangedAt DateTime           @default(now())
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supportedLanguages    RelaisLanguage[]

  @@index([eligibility, availability])
}

model RelaisLanguage {
  id              String        @id @default(cuid())
  relaisProfileId String
  languageCode    String        @db.VarChar(16)
  createdAt       DateTime      @default(now())
  relaisProfile   RelaisProfile @relation(fields: [relaisProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([relaisProfileId, languageCode])
  @@index([languageCode])
}

model Connection {
  id                String                     @id @default(cuid())
  // The FK guarantees an identity; service authorization enforces CUSTOMER role.
  customerId        String
  // Nullable only for Connections created before request idempotency existed.
  requestKey        String?                    @db.VarChar(128)
  lifecycle         ConnectionLifecycle        @default(MATCHING)
  terminalOutcome   ConnectionTerminalOutcome?
  preferredLanguage String?                    @db.VarChar(16)
  createdAt         DateTime                   @default(now())
  connectedAt       DateTime?
  endedAt           DateTime?
  updatedAt         DateTime                   @updatedAt
  customer          User                       @relation("CustomerConnections", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments       ConnectionAssignment[]
  conversation      Conversation?
  quickOffers       QuickOffer[]
  mission           Mission?

  @@unique([customerId, requestKey])
  @@index([customerId, lifecycle])
}

model ConnectionAssignment {
  id               String     @id @default(cuid())
  connectionId     String
  // The FK references User; service authorization enforces active approved RELAIS.
  relaisUserId     String
  assignedAt       DateTime   @default(now())
  endedAt          DateTime?
  reason           String?    @db.Text
  // Nullable to support future system-initiated assignments without a fake user.
  assignedByUserId String?
  connection       Connection @relation(fields: [connectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  relaisUser       User       @relation("RelaisAssignments", fields: [relaisUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedByUser   User?      @relation("AssignmentInitiator", fields: [assignedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([connectionId, assignedAt])
  @@index([relaisUserId, assignedAt])
  @@index([assignedByUserId])
}

model Conversation {
  id           String       @id @default(cuid())
  connectionId String       @unique
  createdAt    DateTime     @default(now())
  connection   Connection   @relation(fields: [connectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  messages     Message[]
  callActions  CallAction[]
}

model Message {
  id              String             @id @default(cuid())
  conversationId  String
  senderUserId    String
  type            MessageType        @default(TEXT)
  text            String?            @db.Text
  clientMessageId String             @db.VarChar(128)
  createdAt       DateTime           @default(now())
  conversation    Conversation       @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sender          User               @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  voiceAsset      VoiceMessageAsset?

  @@unique([conversationId, senderUserId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([senderUserId, createdAt])
}

model VoiceMessageAsset {
  id         String   @id @default(cuid())
  messageId  String   @unique
  storageKey String   @unique @db.VarChar(512)
  mimeType   String   @db.VarChar(64)
  byteSize   Int
  durationMs Int?
  createdAt  DateTime @default(now())
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model CallAction {
  id                String       @id @default(cuid())
  conversationId    String
  initiatedByUserId String
  targetUserId      String
  targetPhoneNumber String       @db.VarChar(20)
  initiatedAt       DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  initiatedBy       User         @relation("CallActionInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  target            User         @relation("CallActionTarget", fields: [targetUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([conversationId, initiatedAt, id])
  @@index([initiatedByUserId, initiatedAt])
  @@index([targetUserId, initiatedAt])
}

model QuickOffer {
  id                    String             @id @default(cuid())
  connectionId          String
  createdByRelaisUserId String
  amount                Int
  currency              String             @db.VarChar(3)
  status                QuickOfferStatus   @default(PENDING)
  clientOfferId         String             @db.VarChar(128)
  createdAt             DateTime           @default(now())
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  supersededAt          DateTime?
  cancelledAt           DateTime?
  connection            Connection         @relation(fields: [connectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByRelais       User               @relation("QuickOfferCreator", fields: [createdByRelaisUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acceptedMission       Mission?           @relation("AcceptedQuickOffer")
  paymentObligation     PaymentObligation? @relation("QuickOfferPaymentSource")

  @@unique([connectionId, createdByRelaisUserId, clientOfferId])
  @@index([connectionId, createdAt, id])
  @@index([createdByRelaisUserId, createdAt])
}

model Mission {
  id                   String              @id @default(cuid())
  connectionId         String              @unique
  depth                MissionDepth
  urgency              MissionUrgency      @default(NORMAL)
  lifecycle            MissionLifecycle    @default(PENDING_EXECUTION)
  acceptedQuickOfferId String?             @unique
  createdAt            DateTime            @default(now())
  completedAt          DateTime?
  cancelledAt          DateTime?
  failedAt             DateTime?
  connection           Connection          @relation(fields: [connectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acceptedQuickOffer   QuickOffer?         @relation("AcceptedQuickOffer", fields: [acceptedQuickOfferId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments          MissionAssignment[]
  paymentObligations   PaymentObligation[]
}

model MissionAssignment {
  id               String    @id @default(cuid())
  missionId        String
  relaisUserId     String
  assignedAt       DateTime  @default(now())
  endedAt          DateTime?
  reason           String?   @db.Text
  assignedByUserId String?
  mission          Mission   @relation(fields: [missionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  relaisUser       User      @relation("MissionRelaisAssignments", fields: [relaisUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedByUser   User?     @relation("MissionAssignmentInitiator", fields: [assignedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([missionId, assignedAt])
  @@index([relaisUserId, assignedAt])
  @@index([assignedByUserId])
}

model PaymentObligation {
  id                 String                   @id @default(cuid())
  missionId          String
  purpose            PaymentObligationPurpose
  amount             Int
  currency           String                   @db.VarChar(3)
  status             PaymentObligationStatus  @default(PENDING)
  sourceQuickOfferId String?                  @unique
  createdAt          DateTime                 @default(now())
  settledAt          DateTime?
  cancelledAt        DateTime?
  mission            Mission                  @relation(fields: [missionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceQuickOffer   QuickOffer?              @relation("QuickOfferPaymentSource", fields: [sourceQuickOfferId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attempts           PaymentAttempt[]

  @@index([missionId, createdAt, id])
  @@index([status, createdAt])
}

model PaymentAttempt {
  id                  String                     @id @default(cuid())
  paymentObligationId String
  amount              Int
  currency            String                     @db.VarChar(3)
  method              PaymentMethod
  provider            String                     @db.VarChar(64)
  externalReference   String?                    @db.VarChar(128)
  status              PaymentAttemptStatus       @default(INITIATED)
  clientAttemptId     String                     @db.VarChar(128)
  initiatedAt         DateTime                   @default(now())
  confirmedAt         DateTime?
  failedAt            DateTime?
  failureCode         String?                    @db.VarChar(64)
  confirmationSource  PaymentConfirmationSource?
  confirmedByUserId   String?
  paymentObligation   PaymentObligation          @relation(fields: [paymentObligationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  confirmedByUser     User?                      @relation("PaymentConfirmationActor", fields: [confirmedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([paymentObligationId, clientAttemptId])
  @@unique([provider, externalReference])
  @@index([paymentObligationId, status, initiatedAt, id])
  @@index([confirmedByUserId])
}
